# Client-side Firebase settings
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Keep disabled unless this Firebase project has a Firestore database.
VITE_FIRESTORE_CHAT_ENABLED=false

# Required server session settings
# Generate at least 32 random bytes. Do not reuse the OTP or provider secrets.
SESSION_SECRET=
SESSION_TTL_MS=1800000
LOGIN_RATE_WINDOW_MS=900000
LOGIN_MAX_ATTEMPTS=10

# Google Sheets (server only)
GOOGLE_MASTER_SHEET_ID=
GOOGLE_CONSOLIDATED_SHEET_ID=
GOOGLE_CONSOLIDATED_TAB=Consolidated_Cases
# Audit events use a separate AuditTrail tab and never alter FIR rows.
# Leave GOOGLE_AUDIT_SHEET_ID empty to use GOOGLE_MASTER_SHEET_ID.
GOOGLE_AUDIT_SHEET_ID=
GOOGLE_AUDIT_TAB=AuditTrail
# Use a separate long random value in production; SESSION_SECRET is the fallback.
AUDIT_HMAC_SECRET=
# Optional local write-ahead path. The default is .runtime/audit-events.jsonl.
AUDIT_LOCAL_PATH=
# Use the JSON value in hosted environments, or a local path during development.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Optional Windows/local override for the CSV sync helper.
PYTHON_EXECUTABLE=

# Copilot providers (server only; comma-separated keys are supported)
GEMINI_API_KEYS=
GROQ_API_KEYS=
GOOGLE_TTS_EN_VOICE=en-IN-Neural2-A
GOOGLE_TTS_KN_VOICE=kn-IN-Wavenet-A
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Kore
# Voice synthesis starts only after user interaction; there is no startup prewarm.
TTS_CACHE_TTL_MS=1800000
TTS_CACHE_MAX_ENTRIES=64
TTS_RATE_WINDOW_MS=60000
TTS_MAX_REQUESTS=30
CHAT_RATE_WINDOW_MS=60000
CHAT_MAX_REQUESTS=20

# Road routing. The public default is suitable for evaluation and light use.
# For production scale, point this to a self-hosted OSRM-compatible service.
ROUTING_BASE_URL=https://router.project-osrm.org
# Place/address search. Self-host Nominatim for high-volume production use.
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
PLACE_SUGGESTION_BASE_URL=https://photon.komoot.io

# Twilio SMS delivery
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Set either a sender phone number or a Messaging Service SID.
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
# Set to false to keep OTP verification available while disabling FIR/status alerts.
SMS_ALERTS_ENABLED=true

# OTP security and rate limits
# Use a long random value in every deployed environment.
OTP_HASH_SECRET=
OTP_EXPIRY_MS=300000
OTP_RESEND_COOLDOWN_MS=60000
OTP_RATE_WINDOW_MS=3600000
OTP_MAX_SENDS_PER_WINDOW=5
OTP_MAX_VERIFY_ATTEMPTS=5
